# Base URL of the Express API, including the version prefix.
# Exposed to the browser, so it must be a publicly reachable URL in production.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Canonical public origin of this site. Used for metadataBase, canonical URLs,
# Open Graph tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Storefront identity rendered across the UI and structured data.
NEXT_PUBLIC_SITE_NAME="Honey Bee Farm"
NEXT_PUBLIC_CONTACT_PHONE=+91 81969 69106
NEXT_PUBLIC_CONTACT_EMAIL=hello@honeybeefarm.local
NEXT_PUBLIC_WHATSAPP_NUMBER=918196969106
