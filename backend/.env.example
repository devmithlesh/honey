# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME="Honey Bee Farm"

# Public URL of the Next.js frontend. Used for password-reset links and CORS.
CLIENT_URL=http://localhost:4000
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:4000

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
#
# For Supabase, set DATABASE_URL only and leave the DB_* values blank. Copy the
# URI from: Dashboard -> Project Settings -> Database -> Connection string.
# Supabase requires TLS, so DB_SSL must be true for a hosted connection.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DB_SSL=true
#
# When DATABASE_URL is empty the discrete values below are used instead, which
# is how the local Postgres container is addressed.
# ---------------------------------------------------------------------------
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=honeybee
DB_USER=postgres
DB_PASSWORD=
DB_DIALECT=postgres
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0

# ---------------------------------------------------------------------------
# Authentication
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Each secret MUST be at least 32 characters and MUST differ from the others.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=replace-me-with-a-third-long-random-string-min-32
JWT_RESET_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# Cookie behaviour. Set COOKIE_SECURE=true and SameSite=none when the API and
# the frontend are served from different sites over HTTPS.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Cloudinary (product / settings image storage)
# Leave blank to disable uploads; upload endpoints will return a clear 503.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=honeybee
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=6

# ---------------------------------------------------------------------------
# SMTP (password reset + order notification email)
# Leave SMTP_HOST blank to log emails to the console instead of sending them.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="Honey Bee Farm"
MAIL_FROM_ADDRESS=no-reply@honeybeefarm.local

# ---------------------------------------------------------------------------
# Seed data — the first administrator account created by `npm run db:seed`.
# Change the password immediately after the first login.
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME="Farm Administrator"
SEED_ADMIN_EMAIL=admin@honeybeefarm.local
SEED_ADMIN_PASSWORD=ChangeMe@12345
