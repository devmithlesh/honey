# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# This repository holds two applications side by side (frontend/ and backend/),
# so the patterns below are deliberately unanchored — a leading slash would only
# match at the repository root and would let `frontend/node_modules` and
# `frontend/.next` (2.9 GB between them) into a commit.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js build output
.next/
out/

# production
build/
dist/

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# Secrets. `.env.example` files are the committed templates and must stay
# readable, so they are re-included after the blanket ignore.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code: shared project settings are committed, personal overrides are not.
.claude/settings.local.json
